node_modules/

# screenshots test_browsers.js drops in the working directory
shot_online_*.png

# everything a running server must not lose: accounts, the hall of fame, the
# playtest notes. One directory so it is one thing to mount and one thing to back
# up - see datadir.js and ENT_DATA_DIR.
data/

# the match history a running server writes: real data, not source
matches.jsonl

# accounts: password hashes, email addresses and the session signing secret.
# This must never be committed - it is the one file here that is a secret.
accounts.json
accounts.json.tmp

# playtest notes: they name players and say what they were doing. Not a secret in
# the way accounts.json is, but it is other people's words and not source.
feedback.json
feedback.json.tmp

# the Instagram kit is generated - make_instagram.mjs rebuilds it from the engine,
# and the captions live at instagram_captions.md so a rebuild cannot delete them
instagram/
